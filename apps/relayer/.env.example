# Never commit the relayer private key. Use a dedicated relayer wallet in production.
RELAYER_PRIVATE_KEY=

# Defaults to the checked-in GIWA Sepolia <-> Ethereum Sepolia deployment record.
RELAYER_DEPLOYMENT_FILE=../../contracts/launch-bridge/deployments/GIWA Sepolia--Ethereum Sepolia.json
RELAYER_STATE_FILE=../../runtime-data/bridge-relayer-state.json

RELAYER_POLL_INTERVAL_MS=5000
RELAYER_CONFIRMATIONS=1
RELAYER_RECEIPT_CONFIRMATIONS=1
RELAYER_MAX_LOG_BLOCK_RANGE=2000
RELAYER_RETRY_BASE_MS=5000
RELAYER_RETRY_MAX_MS=300000
RELAYER_PENDING_TX_TIMEOUT_MS=900000
RELAYER_GAS_LIMIT_MULTIPLIER_BPS=12500

RELAYER_HTTP_HOST=127.0.0.1
RELAYER_HTTP_PORT=8090

# On first start, latest means "start from the current finalized block".
# Set these to 0 for a local two-chain test, or to the bridge deployment blocks
# when the service should replay existing history.
RELAYER_CHAIN_A_START_BLOCK=latest
RELAYER_CHAIN_B_START_BLOCK=latest
