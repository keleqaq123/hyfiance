GIWA_RPC_URL=https://sepolia-rpc.giwa.io
GIWA_FLASHBLOCKS_RPC_URL=https://sepolia-rpc-flashblocks.giwa.io
GIWA_EXPLORER_URL=https://sepolia-explorer.giwa.io
DATABASE_PATH=rwa_exchange.db
BETA_DATABASE_PATH=kelq_beta.db
FRONTEND_ORIGIN=http://127.0.0.1:3001

# Reality Launchpad: use a persistent volume on a VM, PostgreSQL + GCS on Cloud Run.
REALITY_DATA_DIR=./data/reality
# REALITY_DATABASE_URL=postgresql+psycopg://user:password@host/custos
# REALITY_GCS_BUCKET=your-private-upload-bucket
REALITY_PUBLIC_ORIGIN=https://www.custosfinance.xyz
REALITY_ADMIN_WALLETS=
REALITY_LAUNCHPAD_ADDRESS=
REALITY_PLATFORM_TOKEN=
REALITY_SWAP_ROUTER=
REALITY_SWAP_FACTORY=

# Perpetual market data
# Optional path to a private env file containing the Pyth credentials.
# PYTH_ENV_FILE=/absolute/path/to/backend/.env
PYTH_HERMES_URL=https://hermes.pyth.network
# Both variables may contain the same Pyth project API key.
PYTH_API_KEY=
PYTH_PRO_API_KEY=YOUR_PYTH_CORE_API_KEY
PYTH_STREAM_CHANNEL=fixed_rate@200ms
PYTH_STREAM_ENDPOINTS=wss://pyth-lazer-0.dourolabs.app/v1/stream,wss://pyth-lazer-1.dourolabs.app/v1/stream,wss://pyth-lazer-2.dourolabs.app/v1/stream

# Native ETH / account-bound CFI receipts (GIWA Sepolia)
# ETH bridge read-only RPC endpoints; transaction signing stays in the user's wallet.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# GIWA_RPC_URL is shared with the Reality onchain indexer.
REALITY_CFI_STAKING=0x91618694D70100edd9e6508A1d680Ea4E0797592
REALITY_CFI_START_BLOCK=37573108
REALITY_CFI_PRICE_SOURCE=binance
# Dedicated backend signer. Its address must equal the deployed vault quoteSigner.
# Keep the existing private key in backend .env; never use a VITE_ variable.
CFI_QUOTE_SIGNER_KEY=
# Server only. Never put the PYTH_API_KEY above in VITE_ variables.
