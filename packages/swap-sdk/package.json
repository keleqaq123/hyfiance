{
  "name": "custoswap-sdk",
  "license": "MIT",
  "version": "1.0.4",
  "description": "🛠 The TypeScript SDK for Custos Swap V2.",
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "keywords": [
    "custos",
    "swap",
    "ethereum"
  ],
  "module": "dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "start": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "big.js": "^5.2.2",
    "decimal.js-light": "^2.5.0",
    "jsbi": "^3.1.1",
    "tiny-invariant": "^1.1.0",
    "tiny-warning": "^1.0.3",
    "toformat": "^2.0.0"
  },
  "peerDependencies": {
    "@ethersproject/address": "^5.8.0",
    "@ethersproject/contracts": "^5.8.0",
    "@ethersproject/networks": "^5.8.0",
    "@ethersproject/providers": "^5.8.0",
    "@ethersproject/solidity": "^5.8.0"
  },
  "devDependencies": {
    "@ethersproject/address": "^5.8.0",
    "@ethersproject/contracts": "^5.8.0",
    "@ethersproject/networks": "^5.8.0",
    "@ethersproject/providers": "^5.8.0",
    "@ethersproject/solidity": "^5.8.0",
    "@types/chai": "^5.2.3",
    "@types/big.js": "^6.2.2",
    "@types/node": "^22.20.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20"
  },
  "prettier": {
    "printWidth": 120,
    "semi": false,
    "singleQuote": true
  }
}
